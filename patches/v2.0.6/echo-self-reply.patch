+    private void rememberAutoReply(String message) {
+        if (message == null || message.trim().isEmpty()) {
+            return;
+        }
+
+        long now = System.currentTimeMillis();
+        pruneRecentAutoReplies(now);
+
+        RecentAutoReply entry = new RecentAutoReply(now);
+        entry.add(normalize(message));
+
+        for (String line : message.split("[\r\n]+")) {
+            entry.add(normalize(line));
+        }
+
+        recentAutoReplies.add(entry);
+
+        // O motor pode mandar várias partes em sequência. Guardar as últimas
+        // seis já cobre esse caso sem deixar a memória crescer.
+        while (recentAutoReplies.size() > 6) {
+            recentAutoReplies.remove(0);
+        }
+    }
+
+    private boolean isRecentAutoReplyEcho(String rawCandidate) {
+        String raw = normalize(rawCandidate);
+        if (raw.isEmpty()) return false;
+
+        long now = System.currentTimeMillis();
+        pruneRecentAutoReplies(now);
+
+        for (int i = recentAutoReplies.size() - 1; i >= 0; i--) {
+            RecentAutoReply entry = recentAutoReplies.get(i);
+
+            for (String fragment : entry.fragments) {
+                if (fragment.isEmpty()) continue;
+
+                if (raw.equals(fragment)) {
+                    return true;
+                }
+
+                // ContentDescription pode juntar mensagem + horário/status.
+                // Só usamos comparação parcial para trechos razoavelmente
+                // longos, evitando confundir um novo "@infor" do cliente
+                // com uma frase do menu que também contém "@infor".
+                if (fragment.length() >= 12
+                        && raw.length() >= 12
+                        && (raw.contains(fragment)
+                        || fragment.contains(raw))) {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
+
+    private void pruneRecentAutoReplies(long now) {
+        for (int i = recentAutoReplies.size() - 1; i >= 0; i--) {
+            if (now - recentAutoReplies.get(i).createdAt > AUTO_REPLY_ECHO_MS) {
+                recentAutoReplies.remove(i);
+            }
+        }
+    }
