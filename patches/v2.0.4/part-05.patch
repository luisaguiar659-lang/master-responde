+    private boolean containsStandalone(
+            String text,
+            String token
+    ) {
+        int from = 0;
+
+        while (from <= text.length() - token.length()) {
+            int at = text.indexOf(token, from);
+            if (at < 0) return false;
+
+            int beforeIndex = at - 1;
+            int afterIndex = at + token.length();
+
+            boolean beforeOk =
+                    beforeIndex < 0
+                            || !Character.isLetterOrDigit(
+                            text.charAt(beforeIndex)
+                    );
+
+            boolean afterOk =
+                    afterIndex >= text.length()
+                            || !Character.isLetterOrDigit(
+                            text.charAt(afterIndex)
+                    );
+
+            if (beforeOk && afterOk) {
+                return true;
+            }
+
+            from = at + 1;
+        }
+
+        return false;
+    }
