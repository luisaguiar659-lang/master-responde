+    private String stripAccessibilityMetadata(String value) {
+        if (value == null) return "";
+
+        String cleaned = value
+                .replace('\u00a0', ' ')
+                .replace("\u200e", "")
+                .replace("\u200f", "")
+                .trim();
+
+        cleaned = cleaned.replaceAll(
+                "(?i)[,;·•\\s-]*(?:\\d{1,2}:\\d{2}(?:\\s*[ap]m)?)(?:\\s*[,;·•-]?\\s*(?:lida|read|entregue|delivered))?\\s*$",
+                ""
+        );
+
+        cleaned = cleaned.replaceAll(
+                "(?i)[,;·•\\s-]+(?:lida|read|entregue|delivered)\\s*$",
+                ""
+        );
+
+        return cleaned.trim();
+    }
