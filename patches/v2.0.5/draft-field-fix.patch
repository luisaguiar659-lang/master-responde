+    private String readRealDraftText(
+            AccessibilityNodeInfo input
+    ) {
+        if (input == null) return "";
+
+        String text =
+                input.getText() == null
+                        ? ""
+                        : input.getText().toString().trim();
+
+        if (text.isEmpty()) {
+            return "";
+        }
+
+        String normalizedText = normalize(text);
+
+        CharSequence hintValue = null;
+        try {
+            hintValue = input.getHintText();
+        } catch (Throwable ignored) {
+        }
+
+        String hint =
+                hintValue == null
+                        ? ""
+                        : hintValue.toString().trim();
+
+        if (!hint.isEmpty()
+                && normalizedText.equals(normalize(hint))) {
+            return "";
+        }
+
+        if (isEmptyMessagePlaceholder(normalizedText)) {
+            return "";
+        }
+
+        return text;
+    }
+
+    private boolean isEmptyMessagePlaceholder(
+            String normalizedText
+    ) {
+        if (normalizedText == null
+                || normalizedText.trim().isEmpty()) {
+            return true;
+        }
+
+        String value = normalizedText.trim();
+
+        return value.equals("mensagem")
+                || value.equals("message")
+                || value.equals("digite uma mensagem")
+                || value.equals("digitar uma mensagem")
+                || value.equals("type a message")
+                || value.equals("escreva uma mensagem")
+                || value.equals("write a message");
+    }
+
