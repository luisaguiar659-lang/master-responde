+        }
+
+        for (int i = 0; i < node.getChildCount(); i++) {
+            AccessibilityNodeInfo found =
+                    findSendButtonRecursive(
+                            node.getChild(i)
+                    );
+
+            if (found != null) {
+                return found;
+            }
+        }
+
+        return null;
+    }
+
+    private boolean performClick(
+            AccessibilityNodeInfo node
+    ) {
+        AccessibilityNodeInfo current = node;
+
+        for (int i = 0; i < 5 && current != null; i++) {
+            if (current.isClickable()
+                    && current.performAction(
+                    AccessibilityNodeInfo.ACTION_CLICK
+            )) {
+                return true;
+            }
+
+            current = current.getParent();
+        }
+
+        return false;
+    }
+
+    private void updateReplyStatus(String status) {
+        getSharedPreferences("master_responde", MODE_PRIVATE)
+                .edit()
+                .putString(
+                        "accessibility_last_status",
+                        status
+                )
+                .putLong(
+                        "accessibility_last_reply",
+                        System.currentTimeMillis()
+                )
+                .apply();
+    }
+
+    public static boolean isEnabled(Context context) {
+        if (context == null) return false;
+
+        String enabled =
+                Settings.Secure.getString(
+                        context.getContentResolver(),
+                        Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
+                );
+
+        if (enabled == null || enabled.trim().isEmpty()) {
+            return false;
+        }
+
+        String full =
+                context.getPackageName()
+                        + "/"
+                        + WhatsAppAccessibilityService.class.getName();
+
+        String shortName =
+                context.getPackageName()
+                        + "/.WhatsAppAccessibilityService";
+
+        for (String item : enabled.split(":")) {
+            if (full.equalsIgnoreCase(item)
+                    || shortName.equalsIgnoreCase(item)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private static String normalize(String value) {
+        if (value == null) return "";
+
+        return Normalizer.normalize(
+                        value,
+                        Normalizer.Form.NFD
+                )
+                .replaceAll("\\p{M}", "")
+                .toLowerCase(Locale.ROOT)
+                .trim();
+    }
+
+    private static class MessageCandidate {
+        final AccessibilityNodeInfo node;
+        final String text;
+        final Rect bounds;
+
+        MessageCandidate(
+                AccessibilityNodeInfo node,
+                String text,
+                Rect bounds
+        ) {
+            this.node = node;
+            this.text = text;
+            this.bounds = bounds;
+        }
+    }
+}
