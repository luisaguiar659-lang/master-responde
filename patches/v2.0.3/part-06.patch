+        result.add(
+                new MessageCandidate(
+                        node,
+                        text,
+                        r
+                )
+        );
+    }
+
+    private boolean isLikelyOutgoing(
+            AccessibilityNodeInfo node
+    ) {
+        if (node == null) return false;
+
+        AccessibilityNodeInfo current = node;
+
+        for (int i = 0; i < 7 && current != null; i++) {
+            String id =
+                    current.getViewIdResourceName() == null
+                            ? ""
+                            : current.getViewIdResourceName().toLowerCase(Locale.ROOT);
+
+            if (id.contains("outgoing")
+                    || id.contains("from_me")
+                    || id.contains("message_out")) {
+                return true;
+            }
+
+            if (id.contains("incoming")
+                    || id.contains("message_in")) {
+                return false;
+            }
+
+            current = current.getParent();
+        }
+
+        Rect r = new Rect();
+        node.getBoundsInScreen(r);
+
+        int screenWidth =
+                getResources()
+                        .getDisplayMetrics()
+                        .widthPixels;
+
+        return r.centerX() > screenWidth * 0.67f
+                && r.left > screenWidth * 0.18f;
+    }
+
+    public static boolean sendReplyToOpenConversation(
+            String expectedConversation,
+            String message
+    ) {
+        WhatsAppAccessibilityService service =
+                activeInstance;
+
+        if (service == null
+                || message == null
+                || message.trim().isEmpty()) {
+            return false;
+        }
+
+        service.handler.post(
+                () -> service.sendReplyNow(
+                        expectedConversation,
+                        message
+                )
+        );
+
+        return true;
+    }
+
+    private void sendReplyNow(
+            String expectedConversation,
+            String message
+    ) {
+        AccessibilityNodeInfo root =
+                getRootInActiveWindow();
+
+        if (root == null) {
+            updateReplyStatus(
+                    "Chat aberto: tela do WhatsApp indisponível"
+            );
+            return;
+        }
+
+        String actualConversation =
+                findConversationTitle(root);
+
+        if (!expectedConversation.isEmpty()
+                && !actualConversation.isEmpty()
+                && !normalize(expectedConversation).equals(
+                normalize(actualConversation)
+        )) {
+            updateReplyStatus(
+                    "Chat aberto: conversa mudou antes da resposta"
+            );
+            return;
+        }
+
+        AccessibilityNodeInfo input =
+                findInput(root);
+
+        if (input == null) {
+            updateReplyStatus(
+                    "Chat aberto: campo de mensagem não encontrado"
+            );
+            return;
+        }
+
+        CharSequence existing = input.getText();
+
+        // Não apaga um rascunho digitado manualmente pelo usuário.
+        if (existing != null
+                && existing.toString().trim().length() > 0) {
+            updateReplyStatus(
+                    "Chat aberto: resposta não enviada porque há texto digitado"
+            );
+            return;
+        }
+
+        Bundle args = new Bundle();
+        args.putCharSequence(
+                AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE,
+                message
+        );
+
+        boolean filled =
+                input.performAction(
+                        AccessibilityNodeInfo.ACTION_SET_TEXT,
+                        args
+                );
+
+        if (!filled) {
+            updateReplyStatus(
+                    "Chat aberto: não foi possível preencher a mensagem"
+            );
+            return;
+        }
+
+        handler.postDelayed(
+                () -> {
+                    AccessibilityNodeInfo freshRoot =
+                            getRootInActiveWindow();
+
+                    AccessibilityNodeInfo sendButton =
+                            freshRoot == null
+                                    ? null
+                                    : findSendButton(freshRoot);
+
+                    if (sendButton == null
+                            || !performClick(sendButton)) {
+                        updateReplyStatus(
+                                "Chat aberto: botão Enviar não encontrado"
+                        );
+                        return;
+                    }
+
+                    updateReplyStatus(
+                            "Chat aberto: autoresposta enviada"
+                    );
+                },
+                120L
+        );
+    }
+
+    private AccessibilityNodeInfo findSendButton(
+            AccessibilityNodeInfo root
+    ) {
+        String[] ids = new String[]{
+                WHATSAPP_BUSINESS + ":id/send",
+                WHATSAPP_BUSINESS + ":id/send_button"
+        };
+
+        for (String id : ids) {
+            List<AccessibilityNodeInfo> nodes;
+            try {
+                nodes = root.findAccessibilityNodeInfosByViewId(id);
+            } catch (Throwable ignored) {
+                nodes = null;
+            }
+
+            if (nodes != null) {
+                for (AccessibilityNodeInfo node : nodes) {
+                    if (node != null && node.isVisibleToUser()) {
+                        return node;
+                    }
+                }
+            }
+        }
+
+        return findSendButtonRecursive(root);
+    }
