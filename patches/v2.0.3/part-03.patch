+package com.masterresponde.app;
+
+import android.accessibilityservice.AccessibilityService;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Rect;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.view.accessibility.AccessibilityEvent;
+import android.view.accessibility.AccessibilityNodeInfo;
+
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+public class WhatsAppAccessibilityService extends AccessibilityService {
+
+    private static final String WHATSAPP_BUSINESS = "com.whatsapp.w4b";
+    private static final long INSPECT_DELAY_MS = 180L;
+    private static final long LOCAL_DUPLICATE_MS = 1800L;
+    private static final long GROUP_MEMORY_MS = 10L * 60L * 1000L;
+
+    private static volatile WhatsAppAccessibilityService activeInstance;
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+
+    private String lastFingerprint = "";
+    private long lastFingerprintAt = 0L;
+
+    private final Runnable inspectRunnable = this::inspectOpenConversation;
+
+    @Override
+    protected void onServiceConnected() {
+        super.onServiceConnected();
+        activeInstance = this;
+
+        getSharedPreferences("master_responde", MODE_PRIVATE)
+                .edit()
+                .putBoolean("accessibility_engine_connected", true)
+                .putLong("accessibility_engine_last_connected", System.currentTimeMillis())
+                .apply();
+    }
+
+    @Override
+    public void onAccessibilityEvent(AccessibilityEvent event) {
+        if (event == null) return;
+
+        CharSequence packageName = event.getPackageName();
+        if (packageName == null
+                || !WHATSAPP_BUSINESS.contentEquals(packageName)) {
+            return;
+        }
+
+        SharedPreferences prefs =
+                getSharedPreferences("master_responde", MODE_PRIVATE);
+
+        if (!prefs.getBoolean("bot_enabled", false)) {
+            return;
+        }
+
+        handler.removeCallbacks(inspectRunnable);
+        handler.postDelayed(inspectRunnable, INSPECT_DELAY_MS);
+    }
+
+    @Override
+    public void onInterrupt() {
+    }
+
+    @Override
+    public void onDestroy() {
+        handler.removeCallbacksAndMessages(null);
+
+        if (activeInstance == this) {
+            activeInstance = null;
+        }
+
+        getSharedPreferences("master_responde", MODE_PRIVATE)
+                .edit()
+                .putBoolean("accessibility_engine_connected", false)
+                .apply();
+
+        super.onDestroy();
+    }
+
