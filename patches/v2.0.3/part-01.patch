diff -ruN orig_src/app/src/main/java/com/masterresponde/app/ActiveChatNotification.java new_src/app/src/main/java/com/masterresponde/app/ActiveChatNotification.java
--- orig_src/app/src/main/java/com/masterresponde/app/ActiveChatNotification.java	1970-01-01 00:00:00.000000000 +0000
+++ new_src/app/src/main/java/com/masterresponde/app/ActiveChatNotification.java	2026-08-22 17:07:07.000000000 +0000
@@ -0,0 +1,131 @@
+package com.masterresponde.app;
+
+import android.app.Notification;
+import android.app.PendingIntent;
+import android.app.RemoteInput;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+
+public final class ActiveChatNotification {
+
+    private ActiveChatNotification() {
+    }
+
+    public static Notification create(
+            Context context,
+            String conversation,
+            String incoming,
+            boolean group,
+            long eventTime
+    ) {
+        String safeConversation =
+                conversation == null || conversation.trim().isEmpty()
+                        ? (group ? "grupo" : "private")
+                        : conversation.trim();
+
+        Intent replyIntent =
+                new Intent(
+                        context,
+                        ActiveChatReplyReceiver.class
+                );
+
+        replyIntent.setAction(
+                ActiveChatReplyReceiver.ACTION_REPLY
+        );
+
+        replyIntent.putExtra(
+                ActiveChatReplyReceiver.EXTRA_CONVERSATION,
+                safeConversation
+        );
+
+        replyIntent.putExtra(
+                ActiveChatReplyReceiver.EXTRA_GROUP,
+                group
+        );
+
+        int requestCode =
+                (safeConversation + "|" + group).hashCode();
+
+        PendingIntent pendingIntent =
+                PendingIntent.getBroadcast(
+                        context,
+                        requestCode,
+                        replyIntent,
+                        PendingIntent.FLAG_UPDATE_CURRENT
+                                | PendingIntent.FLAG_MUTABLE
+                );
+
+        RemoteInput remoteInput =
+                new RemoteInput.Builder(
+                        ActiveChatReplyReceiver.REMOTE_INPUT_KEY
+                )
+                        .setLabel("Responder")
+                        .setAllowFreeFormInput(true)
+                        .build();
+
+        Notification.Action action =
+                new Notification.Action.Builder(
+                        0,
+                        "Responder",
+                        pendingIntent
+                )
+                        .addRemoteInput(remoteInput)
+                        .build();
+
+        Bundle extras =
+                new Bundle();
+
+        extras.putCharSequence(
+                Notification.EXTRA_TEXT,
+                incoming == null ? "" : incoming
+        );
+
+        extras.putCharSequence(
+                Notification.EXTRA_TITLE,
+                safeConversation
+        );
+
+        if (group) {
+            extras.putBoolean(
+                    Notification.EXTRA_IS_GROUP_CONVERSATION,
+                    true
+            );
+
+            extras.putCharSequence(
+                    Notification.EXTRA_CONVERSATION_TITLE,
+                    safeConversation
+            );
+        }
+
+        Notification notification =
+                new Notification.Builder(
+                        context,
+                        "master_responde_active_chat"
+                )
+                        .setSmallIcon(
+                                android.R.drawable.stat_notify_chat
+                        )
+                        .setContentTitle(
+                                safeConversation
+                        )
+                        .setContentText(
+                                incoming == null ? "" : incoming
+                        )
+                        .setWhen(
+                                eventTime > 0L
+                                        ? eventTime
+                                        : System.currentTimeMillis()
+                        )
+                        .setExtras(extras)
+                        .addAction(action)
+                        .build();
+
+        notification.when =
+                eventTime > 0L
+                        ? eventTime
+                        : System.currentTimeMillis();
+
+        return notification;
+    }
+}
