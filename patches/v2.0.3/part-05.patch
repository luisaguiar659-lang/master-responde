+                WHATSAPP_BUSINESS + ":id/conversation_contact_name",
+                WHATSAPP_BUSINESS + ":id/toolbar_title",
+                WHATSAPP_BUSINESS + ":id/conversation_name",
+                WHATSAPP_BUSINESS + ":id/contact_name"
+        };
+
+        for (String id : ids) {
+            List<AccessibilityNodeInfo> nodes;
+            try {
+                nodes = root.findAccessibilityNodeInfosByViewId(id);
+            } catch (Throwable ignored) {
+                nodes = null;
+            }
+
+            if (nodes == null) continue;
+
+            for (AccessibilityNodeInfo node : nodes) {
+                if (node == null || node.getText() == null) continue;
+
+                String text = node.getText().toString().trim();
+                if (!text.isEmpty()) {
+                    return text;
+                }
+            }
+        }
+
+        List<AccessibilityNodeInfo> topText = new ArrayList<>();
+        collectTopTextNodes(root, topText);
+
+        for (AccessibilityNodeInfo node : topText) {
+            String text =
+                    node.getText() == null
+                            ? ""
+                            : node.getText().toString().trim();
+
+            String normalized = normalize(text);
+
+            if (text.isEmpty()
+                    || normalized.equals("whatsapp business")
+                    || normalized.equals("online")
+                    || normalized.contains("digitando")
+                    || normalized.contains("typing")) {
+                continue;
+            }
+
+            return text;
+        }
+
+        return "";
+    }
