+    private void collectTopTextNodes(
+            AccessibilityNodeInfo node,
+            List<AccessibilityNodeInfo> result
+    ) {
+        if (node == null) return;
+
+        int screenHeight =
+                getResources()
+                        .getDisplayMetrics()
+                        .heightPixels;
+
+        if (node.getText() != null
+                && !node.getText().toString().trim().isEmpty()) {
+            Rect r = new Rect();
+            node.getBoundsInScreen(r);
+
+            if (r.top >= 0
+                    && r.bottom > 0
+                    && r.bottom < screenHeight * 0.20f) {
+                result.add(node);
+            }
+        }
+
+        for (int i = 0; i < node.getChildCount(); i++) {
+            collectTopTextNodes(
+                    node.getChild(i),
+                    result
+            );
+        }
+    }
