+    private void attemptSendReply(
+            String expectedConversation,
+            String message,
+            int attempt
+    ) {
+        AccessibilityNodeInfo freshRoot =
+                getRootInActiveWindow();
+
+        if (freshRoot == null) {
+            retrySendOrFail(
+                    expectedConversation,
+                    message,
+                    attempt,
+                    "Chat aberto: aguardando tela do WhatsApp para enviar"
+            );
+            return;
+        }
+
+        String actualConversation =
+                findConversationTitle(freshRoot);
+
+        if (!expectedConversation.isEmpty()
+                && !actualConversation.isEmpty()
+                && !normalize(expectedConversation).equals(
+                normalize(actualConversation)
+        )) {
+            updateReplyStatus(
+                    "Chat aberto: conversa mudou durante o envio"
+            );
+            finishReplyAndContinue();
+            return;
+        }
+
+        AccessibilityNodeInfo sendButton =
+                findSendButton(freshRoot);
+
+        if (sendButton == null
+                || !performClick(sendButton)) {
+            retrySendOrFail(
+                    expectedConversation,
+                    message,
+                    attempt,
+                    "Chat aberto: aguardando botão Enviar"
+            );
+            return;
+        }
+
+        handler.postDelayed(
+                () -> confirmReplySent(
+                        expectedConversation,
+                        message,
+                        attempt
+                ),
+                SEND_CONFIRM_DELAY_MS
+        );
+    }
+
+    private void confirmReplySent(
+            String expectedConversation,
+            String message,
+            int attempt
+    ) {
+        AccessibilityNodeInfo root =
+                getRootInActiveWindow();
+
+        if (root == null) {
+            retrySendOrFail(
+                    expectedConversation,
+                    message,
+                    attempt,
+                    "Chat aberto: confirmando envio"
+            );
+            return;
+        }
+
+        AccessibilityNodeInfo input =
+                findInput(root);
+
+        if (input == null) {
+            updateReplyStatus(
+                    "Chat aberto: autoresposta enviada"
+            );
+            finishReplyAndContinue();
+            return;
+        }
+
+        String current =
+                normalize(
+                        readRealDraftText(input)
+                );
+
+        String expected =
+                normalize(message);
+
+        if (current.isEmpty()
+                || !current.equals(expected)) {
+            updateReplyStatus(
+                    pendingReplies.isEmpty()
+                            ? "Chat aberto: autoresposta enviada"
+                            : "Chat aberto: autoresposta enviada; processando fila ("
+                            + pendingReplies.size()
+                            + ")"
+            );
+            finishReplyAndContinue();
+            return;
+        }
+
+        retrySendOrFail(
+                expectedConversation,
+                message,
+                attempt,
+                "Chat aberto: envio ainda não confirmado; tentando novamente"
+        );
+    }
+
+    private void retrySendOrFail(
+            String expectedConversation,
+            String message,
+            int attempt,
