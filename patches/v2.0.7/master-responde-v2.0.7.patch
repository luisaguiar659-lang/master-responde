+    private void enqueueReply(
+            String expectedConversation,
+            String message
+    ) {
+        pendingReplies.addLast(
+                new PendingReply(
+                        expectedConversation == null
+                                ? ""
+                                : expectedConversation,
+                        message
+                )
+        );
+
+        if (replySendInProgress) {
+            updateReplyStatus(
+                    "Chat aberto: resposta aguardando na fila ("
+                            + pendingReplies.size()
+                            + ")"
+            );
+            return;
+        }
+
+        processNextReply();
+    }
+
+    private void processNextReply() {
+        if (replySendInProgress) {
+            return;
+        }
+
+        PendingReply next =
+                pendingReplies.pollFirst();
+
+        if (next == null) {
+            return;
+        }
+
+        replySendInProgress = true;
+
+        sendReplyNow(
+                next.expectedConversation,
+                next.message
+        );
+    }
+
+    private void finishReplyAndContinue() {
+        replySendInProgress = false;
+
+        handler.postDelayed(
+                this::processNextReply,
+                250L
+        );
+    }
