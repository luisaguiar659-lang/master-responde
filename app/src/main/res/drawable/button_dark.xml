<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#1200B4FF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#0C2D58" android:endColor="#071933"/>
            <stroke android:width="1dp" android:color="#1479B8"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
