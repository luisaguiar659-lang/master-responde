<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#1500B4FF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#0C2A52" android:endColor="#06152C"/>
            <stroke android:width="1dp" android:color="#1A78B4"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
